{
  "name": "vyvo-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/products.test.ts tests/motion.test.ts tests/hero-showcase.test.ts tests/bilbildin-config.test.ts tests/bilbildin-seed.test.ts tests/bilbildin-catalog.test.ts tests/bilbildin-order.test.ts tests/commerce-experience.test.ts tests/custom-request.test.ts tests/catalog-source-of-truth.test.ts",
    "verify:content": "node scripts/verify-public-actions.mjs",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "fonts:check": "node scripts/subset-fonts.mjs --check",
    "fonts:build": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "@vercel/analytics": "2.0.1",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.32.0",
    "eslint-config-next": "16.2.11",
    "playwright-core": "1.62.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "fontkit": "^2.0.4",
    "subset-font": "^2.5.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
