# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep analytics disabled until a provider and consent policy are approved.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Bilbildin is opt-in. Keep false until the tenant is approved and ready.
BILBILDIN_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VYVO_BUSINESS_ID=
SUPABASE_SECRET_KEY=

# Legacy Supabase names are supported during migration:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_BUSINESS_ID=
